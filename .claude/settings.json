{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(**/GeminiKey.txt)",
      "Edit(**/.venv/**)",
      "Bash(git push --force*)",
      "Bash(git push -f*)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(git reset --hard*)",
      "Bash(git clean *)",
      "Bash(uv add *)",
      "Bash(uv remove *)",
      "Bash(uv lock *)",
      "Edit(**/uv.lock)",
      "Edit(**/pyproject.toml)",
      "Edit(**/.claude/settings.json)"
    ]
  }
}
